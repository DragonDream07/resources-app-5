# ── Application ──────────────────────────────────────────────────────────────
# Node environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Hostname of the PostgreSQL server
DB_HOST=localhost

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Name of the application database
DB_NAME=ecommerce_dev

# PostgreSQL username
DB_USER=postgres

# PostgreSQL password
DB_PASSWORD=postgres

# ── Test Database (used when NODE_ENV=test) ───────────────────────────────────
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=ecommerce_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# ── JSON Web Token ────────────────────────────────────────────────────────────
# Secret key used to sign JWTs — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Token expiry duration (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# ── Bcrypt ───────────────────────────────────────────────────────────────────
# Number of bcrypt salt rounds (higher = slower but more secure)
BCRYPT_ROUNDS=12

# ── Elasticsearch ────────────────────────────────────────────────────────────
# Full URL to the Elasticsearch cluster
ELASTICSEARCH_URL=http://localhost:9200

# Elasticsearch index name for products
ELASTICSEARCH_INDEX=products

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Window size in milliseconds for rate limiting (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Directory where log files are written
LOG_DIR=logs

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. https://example.com)
CORS_ORIGINS=http://localhost:5173
