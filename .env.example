# Base URL for API requests (proxied via Vite in development)
VITE_API_BASE_URL=http://localhost:4000

# App environment
VITE_APP_ENV=development

# Optional: Stripe publishable key for payment integration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Feature flags
VITE_ENABLE_GUEST_CHECKOUT=true
